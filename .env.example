# Copy to .env and fill in values: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=devops_rag
POSTGRES_PASSWORD=devops_rag_secret
POSTGRES_DB=devops_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://devops_rag:devops_rag_secret@localhost:5432/devops_rag

# --- Service ports (local dev without Docker) ---
BACKEND_PORT=3000
RAG_ENGINE_PORT=8000
FRONTEND_PORT=4200

# --- NestJS backend ---
NODE_ENV=development
RAG_ENGINE_URL=http://localhost:8000
BACKEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:4200
# Optional API key for /api/chat. When set, clients must send X-API-Key or Authorization: Bearer <key>.
# Health and webhook endpoints remain public.
# API_KEY=
# Shared data dir for webhooks + ingest jobs (Docker sets /data via compose)
# DATA_DIR=./data

# --- Ingest worker (poll interval in seconds) ---
INGEST_POLL_INTERVAL=2

# --- Phase 1 scrapers (K8s manifests + Ansible playbooks) ---
# Filesystem mode scans local directories and enqueues ingest jobs.
SCRAPER_K8S_PATH=./scripts/seed-data/sources/k8s
SCRAPER_ANSIBLE_PATH=./scripts/seed-data/sources/ansible
SCRAPER_ENVIRONMENT=staging
# Modes: filesystem (default), api (kubectl), git (ansible repo clone)
SCRAPER_K8S_MODE=filesystem
SCRAPER_ANSIBLE_MODE=filesystem
# SCRAPER_ANSIBLE_GIT_URL=https://gitlab.example.com/platform/ansible-playbooks.git
# SCRAPER_ANSIBLE_GIT_BRANCH=main
# SCRAPER_ANSIBLE_SUBPATH=playbooks
# Periodic scraper daemon interval (0 = disabled / one-shot only)
SCRAPER_INTERVAL_SECONDS=0
# GitLab webhook secret token. Set this to a strong random string and copy the
# same value into your GitLab project's Webhooks → "Secret token" field so
# incoming webhook requests can be verified by the backend.
# Generate a token (Linux/macOS):
#   openssl rand -hex 32
# Generate a token (PowerShell):
#   [System.Guid]::NewGuid().ToString()
GITLAB_WEBHOOK_SECRET=change-me

# --- RAG / LLM (choose one provider) ---
# Managed API (recommended for development)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Alternative: Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Alternative: local / private (Ollama via Docker: docker compose --profile ollama up -d)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_PORT=11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Hybrid retrieval tuning
EMBEDDING_DIMENSION=1536
RRF_K=60
RETRIEVAL_TOP_K=10

# --- AWS (Phase 5 - optional, see deploy/aws/README.md) ---
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=devsecops-rag-raw-logs
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
