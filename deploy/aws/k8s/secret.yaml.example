# Copy to secret.yaml and fill values before applying. Do not commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: devsecops-rag-secrets
  namespace: devsecops-rag
type: Opaque
stringData:
  DATABASE_URL: postgresql://user:pass@rds-host:5432/devops_rag
  OPENAI_API_KEY: ""
  GITLAB_WEBHOOK_SECRET: ""
  API_KEY: ""
